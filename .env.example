# Copy to backend/.env or project-root .env. Never commit real keys.

# openai | anthropic | ollama | fallback
AI_PROVIDER=fallback

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Local Ollama (http://127.0.0.1:11434)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Optional override. Electron sets this to the app userData folder.
# EXPENSE_DATA_DIR=

# Dev server
API_HOST=127.0.0.1
API_PORT=8765
